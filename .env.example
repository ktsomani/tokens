# ── Model provider ──────────────────────────────────────────────
# Server-only. Never prefix these with NEXT_PUBLIC_, or Next will
# inline them into the browser bundle.
#
# The app needs OpenAI-compatible chat completions with
# `response_format: json_schema`. Any provider that speaks that
# dialect works — only these three lines change.

# ── Option A: xAI / Grok (paid, no free tier) ──
AI_BASE_URL=https://api.x.ai/v1
AI_API_KEY=
# Model ids use dots, not dashes. grok-4.3 is the cheap,
# long-context one; grok-4.7 is the flagship.
AI_MODEL=grok-4.3

# ── Option B: Google Gemini (has a free tier) ──
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_API_KEY=            # from aistudio.google.com/apikey
# AI_MODEL=gemini-3.8-flash

# XAI_API_KEY and GROK_MODEL are still read as fallbacks.

# ── Supabase (optional) ─────────────────────────────────────────
# Without these the studio works fully; only save-and-share is off.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Keys the HMAC used to hash client IPs for rate limiting.
# Any long random string.
RATE_LIMIT_SALT=
